# Copy to .env and fill in local values. Never commit .env.

# PostgreSQL (host-side default; Docker Compose overrides DATABASE_URL for the API container)
DATABASE_URL=postgresql+psycopg://recs:recs@localhost:5432/recs
TEST_DATABASE_URL=postgresql+psycopg://recs:recs@localhost:5432/recs_test
POSTGRES_USER=recs
POSTGRES_PASSWORD=recs
POSTGRES_DB=recs

# Auth. Use a long random value in any shared environment. Never commit real secrets.
JWT_SECRET=change-me-in-development-only-min-32b
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
CANDIDATE_VISIBILITY_MODE=applicants_and_opted_in

# Scoring implementation selector. "baseline" until a trained model is evaluated and activated.
RANKER_IMPL=baseline

# Frozen Sentence-Transformers encoder. Cosine similarity is a feature, not a recruitment score.
# EMBEDDING_MODEL_VERSION is an application pin, not a Hugging Face git SHA.
# EMBEDDING_MODEL_REVISION is optional; leave empty to use the library default snapshot.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_VERSION=all-minilm-l6-v2-v1
EMBEDDING_MODEL_REVISION=
EMBEDDING_TEXT_VERSION=embedding-text-v1
EMBEDDING_BACKEND=sentence_transformers

# Local blob storage for resumes (Phase 1+). Inside Docker this is /app/storage.
BLOB_ROOT=./storage
MAX_RESUME_BYTES=5242880
DOCUMENT_PARSER_VERSION=document-parser-v1
NLP_PIPELINE_VERSION=nlp-v1
ONTOLOGY_DEFAULT_VERSION=seed-0.1
ONTOLOGY_FUZZY_THRESHOLD=0.92
ONTOLOGY_MAX_DEPTH=4

# Baseline matching weights. Heuristic starting values, not empirically optimal.
FEATURE_SCHEMA_VERSION=feature-schema-v1
MATCH_WEIGHT_SET_VERSION=baseline-weights-v1
MATCH_WEIGHT_REQUIRED=0.60
MATCH_WEIGHT_PREFERRED=0.10
MATCH_WEIGHT_SEMANTIC=0.15
MATCH_WEIGHT_EXPERIENCE=0.10
MATCH_WEIGHT_EDUCATION_PROJECT=0.05
PROJECT_EVIDENCE_COSINE_THRESHOLD=0.45
EXPERIENCE_EVIDENCE_COSINE_THRESHOLD=0.45

# Potential (gap closability) heuristics. Independent of current-match weights. Not trained.
POTENTIAL_WEIGHT_SET_VERSION=potential-weights-v1
POTENTIAL_MAX_GRAPH_DISTANCE=2
POTENTIAL_WEIGHT_EXACT=1.0
POTENTIAL_WEIGHT_CHILD=0.8
POTENTIAL_WEIGHT_PARENT=0.5
POTENTIAL_WEIGHT_RELATED=0.6
POTENTIAL_WEIGHT_SIMILAR=0.5
POTENTIAL_TWO_HOP_FACTOR=0.5
POTENTIAL_COMPONENT_GRAPH=0.40
POTENTIAL_COMPONENT_ADJACENT=0.20
POTENTIAL_COMPONENT_PROJECTS=0.15
POTENTIAL_COMPONENT_EXPERIENCE=0.15
POTENTIAL_COMPONENT_CERTIFICATIONS=0.05
POTENTIAL_COMPONENT_SEMANTIC=0.05
POTENTIAL_SEMANTIC_COSINE_THRESHOLD=0.45

# Phase 9 dataset reporting only. Does not train a model.
LABEL_POLICY_VERSION=label-policy-v1
MIN_TRAINING_ROWS=50
MIN_POSITIVE_LABELS=5
MIN_NEGATIVE_LABELS=5
MIN_UNIQUE_JOBS=2
ML_CV_FOLDS=5
ML_RANDOM_SEED=42
ML_PRIMARY_METRIC=ndcg_at_5
MODEL_ARTIFACT_DIR=ml/artifacts
XGB_N_ESTIMATORS=80
XGB_MAX_DEPTH=3
XGB_LEARNING_RATE=0.1
XGB_SUBSAMPLE=0.8
XGB_COLSAMPLE_BYTREE=0.8
XGB_MIN_CHILD_WEIGHT=1
XGB_REG_LAMBDA=1.0

ENVIRONMENT=development

# Browser origin allowed to call the API. Do not use * when cookies are involved.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend → API (browser). From the host this is localhost, not the Docker service name.
NEXT_PUBLIC_API_URL=http://localhost:8000
